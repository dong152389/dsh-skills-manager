{
  "name": "dsh-skills-manager",
  "description": "DeepSeek Harness 的 Skills 目录管理插件：按工作区浏览、搜索并查看技能来源与正文。",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dong152389/dsh-skills-manager.git"
  },
  "homepage": "https://github.com/dong152389/dsh-skills-manager#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.0 <0.3.0-0",
      "dshReleases": {
        "0.2.2-rc.5": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.0 <0.3.0-0"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "img",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs"
  ],
  "keywords": [
    "cordis",
    "dsh",
    "skills",
    "agent"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "check": "npm test && npm run build"
  }
}
